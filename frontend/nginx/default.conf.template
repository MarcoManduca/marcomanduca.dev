server {
    # nginx-unprivileged runs as a non-root user, so it cannot bind to :80.
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Security headers (production parity; in the deployed stack the SPA is
    # served by CloudFront, which applies the canonical policy).
    include /etc/nginx/snippets/security-headers.conf;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Proxy API calls to the backend service (env-templated upstream).
    # The upstream is resolved at request time via Docker's embedded DNS
    # (127.0.0.11) using a variable in proxy_pass, so nginx does not fail to
    # start if the backend is not yet resolvable. BACKEND_UPSTREAM must be a
    # bare scheme://host:port with no trailing path.
    location /api/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $backend_upstream ${BACKEND_UPSTREAM};
        proxy_pass $backend_upstream$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Immutable hashed assets
    location /assets/ {
        # add_header here would otherwise drop the server-level headers.
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }
}
