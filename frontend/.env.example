# Backend REST API base URL (FastAPI, /api/v1)
VITE_API_BASE_URL=/api/v1

# AWS Cognito (OIDC)
VITE_COGNITO_AUTHORITY=https://cognito-idp.eu-west-1.amazonaws.com/eu-west-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=your-cognito-app-client-id
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/admin/callback
# Cognito hosted UI origin (used for the sign-out /logout redirect)
VITE_COGNITO_DOMAIN=https://your-prefix.auth.eu-west-1.amazoncognito.com
