# .env.example — committed to the repo with placeholder values only.
# Copy to .env for local development. The real .env is never committed.

# Environment: "local" keeps /docs and allows an empty ORIGIN_VERIFY_SECRET.
# Anything deployed must use "prod" (the default when unset): docs are
# disabled and the app refuses to start without ORIGIN_VERIFY_SECRET.
APP_ENV=local

# AWS
AWS_REGION=eu-west-1

# DynamoDB tables
PROJECTS_TABLE_NAME=portfolio-projects
LEARNING_TABLE_NAME=portfolio-learning
TECHNOLOGIES_TABLE_NAME=portfolio-technologies
RATELIMIT_TABLE_NAME=portfolio-ratelimit

# Optional: point boto3 at DynamoDB Local for development
# DYNAMODB_ENDPOINT_URL=http://localhost:8001

# S3
MEDIA_BUCKET_NAME=marcomanduca-dev-media
PRESIGN_EXPIRATION_SECONDS=900

# Cognito
COGNITO_USER_POOL_ID=eu-west-1_xxxxxxxxx
COGNITO_CLIENT_ID=your-app-client-id

# SES
SES_SENDER_EMAIL=noreply@marcomanduca.dev
SES_RECIPIENT_EMAIL=owner@marcomanduca.dev

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,https://marcomanduca.dev

# CloudFront origin secret (X-Origin-Verify). Empty locally (check disabled);
# mandatory in prod, set from Terraform so only CloudFront-forwarded requests
# reach the API Gateway origin.
ORIGIN_VERIFY_SECRET=

# Contact form rate limit (state in the ratelimit table). Per IP: fixed window,
# keyed on the CloudFront-set x-viewer-ip header. Plus a site-wide daily cap.
CONTACT_RATE_LIMIT_MAX_REQUESTS=5
CONTACT_RATE_LIMIT_WINDOW_SECONDS=900
CONTACT_RATE_LIMIT_DAILY_MAX=50
